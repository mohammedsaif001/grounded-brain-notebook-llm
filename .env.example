# Validated on boot by src/config/env.ts — the server exits with a list of problems if anything is wrong.
NODE_ENV=development
PORT=8080
# Matches docker-compose.yml (`docker compose up -d`)
DATABASE_URL=postgresql://postgres:admin@localhost:5434/grounded-brain-notebook-llm
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000
CLIENT_URL=http://localhost:3000
# Reverse proxies in front of the app (load balancer/CDN) so rate limiting sees real client IPs. 0 = none.
TRUST_PROXY_HOPS=0
# Log level: fatal | error | warn | info | debug | trace | silent (default: debug in dev, info in prod)
LOG_LEVEL=

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Cloudinary (PDF uploads) — unsigned upload preset from Dashboard → Upload → Upload Presets
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_UPLOAD_PRESET=
# Optional: signed download URLs for re-processing PDFs uploaded before inline extraction
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Firecrawl (website imports)
FIRECRAWL_API_KEY=

# Inngest (local dev — run `npx inngest-cli@latest dev` alongside the server)
INNGEST_DEV=1
# Required when NODE_ENV=production and INNGEST_DEV is not set
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=

# OpenAI — gpt-4o-mini for chat, text-embedding-3-small (1536 dims) for Pinecone
OPENAI_API_KEY=
# Outbound OpenAI throttling (shared by chat, generation, and embeddings). Tune to your account tier.
OPENAI_MAX_CONCURRENCY=4
OPENAI_REQUESTS_PER_MINUTE=300
# Requests allowed to wait in the queue before new ones get a 429 "AI service is busy".
OPENAI_MAX_QUEUE=100

# Pinecone — index is auto-created with 1536 dimensions (cosine) if missing
PINECONE_API_KEY=
PINECONE_INDEX=groundedbrain

# GitHub (optional) � repo imports work without it for public repos but hit the 60 req/h anonymous limit.
# Create a fine-grained read-only token (Contents: read) to raise the limit and read private repos.
GITHUB_TOKEN=

# TAVILy & Mem0 API Key
TAVILY_API_KEY=
MEM0_API_KEY=



# LangFuse for AI Telemetry
LANGFUSE_SECRET_KEY= 
LANGFUSE_PUBLIC_KEY= 
# Blank = EU cloud (https://cloud.langfuse.com); US: https://us.cloud.langfuse.com
LANGFUSE_BASE_URL=

# Axiom log shipping (optional) — set AXIOM_TOKEN to also send every pino log line to Axiom.
# Token: Axiom → Settings → API tokens, with Ingest permission on the dataset.
AXIOM_TOKEN=
AXIOM_DATASET=
# Regional ingest domain (no https://). 
AXIOM_EDGE=