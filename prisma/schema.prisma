// Prisma schema entry point: generator and datasource only.
//
// Models live in ./models, one file per model (with the enums it owns).
// Prisma has no `import` statement: prisma7.config.ts points `schema` at this
// folder, and every *.prisma file in it is merged into one schema.
// Learn more: https://pris.ly/d/multi-file-schema

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}
