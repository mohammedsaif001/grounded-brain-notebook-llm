// A chunk of a source's text; its embedding lives in Pinecone under the same id.
model SourceChunk {
  id         String   @id @default(cuid())
  sourceId   String
  index      Int
  content    String
  tokenCount Int?
  metadata   Json?
  // Left out of chat retrieval and artifact generation when true; the embedding is kept.
  excluded   Boolean  @default(false)
  createdAt  DateTime @default(now())
  source     Source   @relation(fields: [sourceId], references: [id], onDelete: Cascade)

  @@unique([sourceId, index])
  @@index([sourceId])
  @@map("source_chunk")
}
