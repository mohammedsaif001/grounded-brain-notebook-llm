// One chat turn; assistant messages carry the citations they used.
model Message {
  id             String       @id @default(cuid())
  conversationId String
  role           MessageRole
  content        String
  citations      Json?
  // Set by the chat guard on blocked messages and their refusals. Kept so the UI can show
  // them, but excluded from model history, summaries and Mem0 so attacks can't persist.
  blocked        Boolean      @default(false)
  createdAt      DateTime     @default(now())
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId])
  @@index([conversationId, createdAt])
  @@map("message")
}

enum MessageRole {
  USER
  ASSISTANT
}
