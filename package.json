{
  "name": "Grounded Brain Notebook LLM",
  "version": "1.0.0",
  "description": "Grounded Brain: a NotebookLM-style backend. Chat with your PDFs, websites, YouTube videos and notes using RAG with citations, plus AI-generated summaries, flashcards, quizzes and mind maps.",
  "main": "dist/server.js",
  "scripts": {
    "dev": "npm run docker:up && npm run db:migrate:deploy && npm run db:generate && concurrently --kill-others-on-fail --names api,inngest,studio --prefix-colors blue,magenta,green \"npm:dev:api\" \"npm:dev:inngest\" \"npm:db:studio\"",
    "dev:api": "tsx watch src/server.ts",
    "dev:inngest": "npx --yes inngest-cli@latest dev --no-discovery -u http://localhost:8080/api/inngest",
    "build": "prisma generate && tsc",
    "start": "node dist/server.js",
    "docker:up": "docker compose up -d --wait",
    "docker:down": "docker compose down",
    "docker:reset": "docker compose down -v && npm run docker:up && npm run db:migrate:deploy",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:migrate:deploy": "prisma migrate deploy",
    "db:studio": "prisma studio --port 5555",
    "typecheck": "tsc --noEmit && tsc -p scripts",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "npm run typecheck && npm run lint && npm run format:check",
    "smoke": "tsx scripts/smoke-test.ts"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mohammedsaif001/grounded-brain-notebook-llm.git"
  },
  "keywords": [
    "rag",
    "retrieval-augmented-generation",
    "notebooklm",
    "notebooklm-clone",
    "notebooklm-alternative",
    "ai-notebook",
    "second-brain",
    "knowledge-base",
    "chat-with-pdf",
    "chat-with-documents",
    "document-qa",
    "semantic-search",
    "vector-search",
    "embeddings",
    "pinecone",
    "openai",
    "gpt-4o",
    "llm",
    "generative-ai",
    "ai-sdk",
    "vercel-ai-sdk",
    "inngest",
    "background-jobs",
    "mem0",
    "long-term-memory",
    "langfuse",
    "llm-observability",
    "prisma",
    "postgresql",
    "express",
    "typescript",
    "nodejs",
    "better-auth",
    "flashcards",
    "quiz-generator",
    "mind-map",
    "youtube-transcript",
    "web-scraping",
    "firecrawl",
    "tavily",
    "web-search"
  ],
  "author": "Mohammed Saif",
  "license": "ISC",
  "type": "module",
  "bugs": {
    "url": "https://github.com/mohammedsaif001/grounded-brain-notebook-llm/issues"
  },
  "homepage": "https://github.com/mohammedsaif001/grounded-brain-notebook-llm#readme",
  "dependencies": {
    "@ai-sdk/openai": "^4.0.96",
    "@langchain/core": "^1.2.18",
    "@langchain/textsplitters": "^1.0.2",
    "@langfuse/otel": "^6.0.1",
    "@langfuse/tracing": "^6.0.1",
    "@langfuse/vercel-ai-sdk": "^6.0.1",
    "@mendable/firecrawl-js": "^4.49.1",
    "@opentelemetry/api": "^1.9.1",
    "@opentelemetry/sdk-trace-node": "^2.12.0",
    "@pinecone-database/pinecone": "^8.2.0",
    "@prisma/adapter-pg": "^7.10.1",
    "@prisma/client": "^7.10.1",
    "@tavily/core": "^0.7.14",
    "ai": "^7.0.143",
    "better-auth": "^1.7.11",
    "cloudinary": "^2.11.0",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.3.0",
    "express-rate-limit": "8.7.0",
    "inngest": "^4.24.0",
    "js-tiktoken": "^1.0.21",
    "mem0ai": "^3.3.1",
    "multer": "^2.4.0",
    "openai": "^7.39.0",
    "p-queue": "9.3.3",
    "pg": "^8.23.1",
    "pino": "^10.4.0",
    "pino-http": "^11.0.0",
    "sanitize-filename": "^1.6.4",
    "unpdf": "^1.9.1",
    "youtube-transcript": "^1.3.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/multer": "^2.3.0",
    "@types/node": "^24.19.2",
    "@types/pg": "^8.23.1",
    "concurrently": "10.0.6",
    "eslint": "10.12.0",
    "eslint-config-prettier": "10.1.8",
    "globals": "17.13.0",
    "pino-pretty": "13.2.0",
    "prettier": "3.9.9",
    "prisma": "^7.10.1",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "typescript-eslint": "8.71.1"
  }
}
